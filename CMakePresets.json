{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CPM_SOURCE_CACHE": "$env{HOME}/.cache/CPM"
      }
    },
    {
      "name": "ccache",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "description": "AddressSanitizer + UBSan. The environment reaches build and test runs made through presets, not a binary started by hand.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SMC_SANITIZE": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1",
        "LSAN_OPTIONS": "verbosity=1:log_threads=1"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": [
        "base",
        "ccache"
      ],
      "description": "Native Linux build; shown only on a Linux host.",
      "binaryDir": "${sourceDir}/build/linux/${presetName}",
      "installDir": "${sourceDir}/install/linux/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "wasm",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "description": "WebAssembly through Emscripten, from any host. Set EMSCRIPTEN_ROOT to the emscripten directory: /usr/lib/emscripten on Arch, <emsdk>/upstream/emscripten with emsdk.",
      "binaryDir": "${sourceDir}/build/wasm/${presetName}",
      "installDir": "${sourceDir}/install/wasm/${presetName}",
      "toolchainFile": "$env{EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_LINKER_TYPE": "LLD"
      }
    },
    {
      "name": "gcc_debug",
      "displayName": "linux-gcc-debug",
      "inherits": [
        "linux",
        "gcc",
        "debug"
      ]
    },
    {
      "name": "gcc_release",
      "displayName": "linux-gcc-release",
      "inherits": [
        "linux",
        "gcc",
        "release"
      ]
    },
    {
      "name": "clang_debug",
      "displayName": "linux-clang-debug",
      "inherits": [
        "linux",
        "clang",
        "debug"
      ]
    },
    {
      "name": "clang_release",
      "displayName": "linux-clang-release",
      "inherits": [
        "linux",
        "clang",
        "release"
      ]
    },
    {
      "name": "clang_asan",
      "displayName": "linux-clang-asan",
      "inherits": [
        "linux",
        "clang",
        "asan"
      ]
    },
    {
      "name": "wasm_debug",
      "displayName": "wasm-debug",
      "inherits": [
        "wasm",
        "debug"
      ]
    },
    {
      "name": "wasm_release",
      "displayName": "wasm-release",
      "inherits": [
        "wasm",
        "release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "gcc_debug",
      "configurePreset": "gcc_debug",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "gcc_release",
      "configurePreset": "gcc_release",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "linux_clang_debug",
      "configurePreset": "clang_debug",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "clang_release",
      "configurePreset": "clang_release",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "clang_asan",
      "configurePreset": "clang_asan",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "wasm_debug",
      "configurePreset": "wasm_debug"
    },
    {
      "name": "wasm_release",
      "configurePreset": "wasm_release"
    }
  ],
  "testPresets": [
    {
      "name": "linux",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "gcc_debug",
      "configurePreset": "gcc_debug",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "gcc_release",
      "configurePreset": "gcc_release",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "clang_debug",
      "configurePreset": "clang_debug",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "clang_release",
      "configurePreset": "clang_release",
      "inherits": [
        "linux"
      ]
    },
    {
      "name": "clang_asan",
      "configurePreset": "clang_asan",
      "inherits": [
        "linux"
      ]
    }
  ]
}
