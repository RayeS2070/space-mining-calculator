# Writes a file into a C++ source as a byte array, with a function that
# returns it as std::string_view. Runs at build time:
#
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DHEADER=<header>
#         -DNAMESPACE=<namespace> -DFUNCTION=<name> -P embed.cmake
#
# HEADER, as written in #include "...", declares `auto
# <NAMESPACE>::<FUNCTION>() -> std::string_view;`. Bytes, not a string literal: no delimiter to collide
# with the data and no limit on literal length (MSVC has one).

foreach(var INPUT OUTPUT HEADER NAMESPACE FUNCTION)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "embed.cmake: ${var} is not set")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(REGEX REPLACE "(..)" "0x\\1, " bytes "${hex}")
# 12 bytes per line. CMake regexes have no {n}: the group is spelled out.
string(REPEAT "0x.., " 12 line)
string(REGEX REPLACE "(${line})" "\\1\n    " bytes "${bytes}")
string(REPLACE " \n" "\n" bytes "${bytes}")
cmake_path(GET INPUT FILENAME name)

file(WRITE "${OUTPUT}" "\
// Generated by cmake/embed.cmake from ${name}. Do not edit.
#include \"${HEADER}\"

#include <string_view>

namespace ${NAMESPACE} {
namespace {

// A trailing 0, so the array is never empty.
constexpr unsigned char kData[] = {
    ${bytes}0x00};

}  // namespace

auto ${FUNCTION}() -> std::string_view {
  // Reading unsigned char bytes through char is allowed aliasing.
  return {reinterpret_cast<const char*>(kData), sizeof kData - 1};
}

}  // namespace ${NAMESPACE}
")
